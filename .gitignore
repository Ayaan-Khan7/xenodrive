# ==============================================================================
# CloudVault (xenoDrive) Root .gitignore
# ==============================================================================

# Environment files & Secrets (CRITICAL: NEVER COMMIT)
.env
.env.local
.env.*.local
.env.production
.env.development
*.env

# Dependencies
node_modules/
*/node_modules/

# Production build outputs
dist/
dist-ssr/
client/dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor generated files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test & Coverage
coverage/
.nyc_output/

# Temporary storage
uploads/
tmp/
temp/
