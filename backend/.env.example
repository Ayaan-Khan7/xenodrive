# ==============================================================================
# CloudVault (xenoDrive) Backend Environment Variables
# ==============================================================================
# INSTRUCTIONS: Copy this file to .env for local development.
# NEVER commit .env files to GitHub. In production, configure these variables
# directly in the Render dashboard (Environment tab).
# ==============================================================================

# Application Environment (development | production | test)
NODE_ENV=production

# Server Port (Render automatically sets PORT in production; default 10000 or 5000)
PORT=5000

# ------------------------------------------------------------------------------
# 1. DATABASE: MongoDB Atlas Free M0
# ------------------------------------------------------------------------------
# Create a free cluster on https://cloud.mongodb.com
# Database Access: Create a user with readWriteAnyDatabase permission.
# Network Access: Allow IP Access from 0.0.0.0/0 (required for Render dynamic IPs).
# Format: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/cloudvault?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://db_user:password123@cluster0.abcde.mongodb.net/cloudvault?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. CORS & FRONTEND CLIENT WHITELIST
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (WITHOUT trailing slashes).
# In production, set to your Vercel URL (e.g., https://cloudvault.vercel.app).
# All *.vercel.app preview branches are automatically allowed in production mode.
CLIENT_URL=https://your-frontend.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 64-byte hex string in Node.js:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_64_character_hex_secret_in_production
JWT_EXPIRES_IN=7d

# Rate Limiting (100 requests per 15 minutes by default)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE: S3-Compatible Cloud Storage (Supabase S3 / Cloudflare R2)
# ------------------------------------------------------------------------------
# Option A: Supabase S3 (100% Free, No Credit Card Required)
# Supabase Dashboard -> Storage -> S3 Access Keys -> New Access Key
# Endpoint format: https://<project-ref>.storage.supabase.co/storage/v1/s3
R2_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
R2_REGION=ap-northeast-1
R2_ACCESS_KEY_ID=your_supabase_s3_access_key
R2_SECRET_ACCESS_KEY=your_supabase_s3_secret_key
R2_BUCKET_NAME=cloudvault

# Option B: Cloudflare R2 (Requires card verification for account creation)
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=cloudvault

# Optional: Public bucket domain or custom subdomain (e.g., https://pub-xxx.r2.dev)
R2_PUBLIC_DOMAIN=

# ------------------------------------------------------------------------------
# 5. STORAGE QUOTA & FILE SIZE LIMITS (in bytes)
# ------------------------------------------------------------------------------
# Maximum upload size per individual file (default: 50 MB = 52428800 bytes)
MAX_FILE_SIZE=52428800

# Default per-user storage allocation quota (default: 1 GB = 1073741824 bytes)
DEFAULT_STORAGE_LIMIT=1073741824

# Cloudflare R2 Presigned Upload & Download URL expiration (default: 3600 seconds = 1 hour)
PRESIGNED_URL_EXPIRES_IN=3600
